# PORT: set by Hostinger in production - do not set it there. Local development defaults to 5000.
# PORT=5000
NODE_ENV=development

# Either set DATABASE_URL, or the individual DB_* values below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capital_car_sharing
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capital_car_sharing
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# Time zone that decides what "today" is for car availability (IANA name, e.g. Asia/Karachi). Default: UTC.
# Keep NEXT_PUBLIC_* / siteConfig.timeZone on the frontend equal to this.
BUSINESS_TIME_ZONE=UTC

# --- Car photo uploads (local storage) ---
# Origin the BROWSER uses to reach this API. Every stored photo URL starts with it.
#   local development : http://localhost:5000
#   production        : https://api.capitalcarsharing.com   (https, never localhost - the app refuses to start otherwise)
PUBLIC_BASE_URL=http://localhost:5000
# "local" = files on this server's disk, served at {PUBLIC_BASE_URL}/uploads/...
STORAGE_DRIVER=local
# Folder for the PUBLIC car photos. Production: an ABSOLUTE folder OUTSIDE the deployed app, e.g.
#   UPLOAD_DIR=~/capital-storage/uploads      ("~" = your Hostinger home folder, e.g. /home/u123456789)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Password reset emails (Forgot Password for Customer, Partner and Admin) ---
# Public address of the Next.js app. Reset links in emails are built from it:
#   {FRONTEND_URL}/reset-password?token=...            (customer)
#   {FRONTEND_URL}/partner/reset-password?token=...    (partner)
#   {FRONTEND_URL}/admin/reset-password?token=...      (admin)
FRONTEND_URL=http://localhost:3000
# SMTP server used to send the emails. Leave SMTP_HOST empty to disable sending (no email will be sent).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false uses STARTTLS when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# "From" address, e.g. Capital Car Sharing <no-reply@your-domain.com>. Defaults to SMTP_USER.
SMTP_FROM=
# How long a reset link stays valid, and the minimum gap between two links for the same account
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# --- Customer identity verification ---
# Private storage for identity documents. MUST be a different folder from UPLOAD_DIR (which is served publicly). Never expose it.
# Production: an absolute folder outside the app, e.g. ~/capital-storage/private-uploads (copy existing files there first).
VERIFICATION_STORAGE_DIR=private-uploads
# Encrypts the stored document number (AES-256-GCM). REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it makes already-stored document numbers unreadable.
VERIFICATION_ENCRYPTION_KEY=
# Accepted identity documents, comma separated: national_id, passport, driving_licence (default: all three)
VERIFICATION_DOCUMENT_TYPES=national_id,passport,driving_licence
# Set to false to stop asking for a document number at all
VERIFICATION_REQUIRE_DOCUMENT_NUMBER=true
# Restrict countries of residence to these ISO codes (comma separated). Empty = every country.
VERIFICATION_ALLOWED_COUNTRIES=
VERIFICATION_MIN_AGE=18
# Per file (front / back). JPG, PNG, WebP and PDF are accepted.
VERIFICATION_MAX_FILE_MB=5
# Documents are deleted this many days after a review decision (run: npm run verification:purge). 0 = never delete automatically.
VERIFICATION_RETENTION_DAYS=30
# Submissions allowed per customer per 15 minutes
VERIFICATION_SUBMIT_LIMIT=20
