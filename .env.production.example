# Production values for Hostinger (Deployments -> Deployment settings -> Environment variables).
# Copy these into hPanel. Do NOT commit real secrets. Do NOT set PORT: Hostinger provides it.

NODE_ENV=production
# !! If you switch NODE_ENV from "development" to "production", VERIFICATION_ENCRYPTION_KEY becomes mandatory
# (see UPLOADS.md, "NODE_ENV and the encryption key") - otherwise saved ID-document numbers become unreadable.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://www.capitalcarsharing.com,https://capitalcarsharing.com
FRONTEND_URL=https://www.capitalcarsharing.com

# ---- Car photo uploads: local storage ----
STORAGE_DRIVER=local
PUBLIC_BASE_URL=https://api.capitalcarsharing.com
UPLOAD_DIR=~/capital-storage/uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ---- Identity documents (PRIVATE, never served) ----
# Different folder from UPLOAD_DIR. Copy existing files here before switching (see UPLOADS.md).
VERIFICATION_STORAGE_DIR=~/capital-storage/private-uploads
VERIFICATION_ENCRYPTION_KEY=

# ---- Email (optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Capital Car Sharing <no-reply@capitalcarsharing.com>
